{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨稿",
  "version": "0.1.0",
  "identifier": "com.mogao.novelstudio",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "墨稿 · AI 小说工坊",
        "width": 1320,
        "height": 880,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
